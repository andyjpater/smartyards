# From https://discord.com/developers/applications -> your app
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Right-click the server icon -> Copy Server ID (needs Developer Mode on)
DISCORD_GUILD_ID=

# All schedules run in this timezone
TIMEZONE=Australia/Sydney

# Weekly Sales Clinic (creates Discord events automatically; set CLINIC_ENABLED=false to schedule by hand)
CLINIC_ENABLED=true
CLINIC_WEEKDAY=2          # 1=Mon ... 7=Sun
CLINIC_TIME=12:00         # 24h local time
CLINIC_DURATION_MINUTES=60
CLINIC_WEEKS_AHEAD=2

# Weekly scoreboard reminder
SCOREBOARD_WEEKDAY=5      # Friday
SCOREBOARD_TIME=15:00

# Hours before any scheduled event to post reminders (comma separated)
EVENT_REMINDER_HOURS=24,1
